diff --git a/lib/service_linux.sh b/lib/service_linux.sh
index 77453a2..16e38a5 100644
--- a/lib/service_linux.sh
+++ b/lib/service_linux.sh
@@ -132,14 +132,25 @@ _svc_ensure_tenant_slice_dropin() {
 #               group (RestrictAddressFamilies, RestrictSUIDSGID,
 #               LockPersonality, RestrictRealtime, SystemCallArchitectures)
 #   NOT honoured by the user manager here (so deliberately NOT written, a
-#   claim that is not true would be worse than no claim): PrivateTmp,
-#   ProtectHome, ProtectControlGroups, ProtectProc, PrivateDevices,
+#   claim that is not true would be worse than no claim): ProtectHome, ProtectControlGroups, ProtectProc, PrivateDevices,
 #   ProtectClock, CapabilityBoundingSet.
 # "basic" is applied to chat engines (their GPU/CUDA stacks are unrestricted
 # beyond the two always-safe directives); "strict" to decision components,
 # which only need TCP/unix sockets and the file system.
+#
+# HRD-039 (operator decision 2026-11-23, option c): the ENGINE unit template (llmctl-llama@/onnx@/colibri@, which run
+# the ExecStartPre `gate` hook) passes "no-protectsystem". Under ProtectSystem=full the unit's mount namespace shows
+# /dev/shm owned by uid 65534 (nobody) instead of root, so lib/reserve.sh `_rsv_admit_dir_ok` (sticky dir must be owned
+# by root or the caller) fails closed and the engine can never start. Lost protection: /usr, /boot and /etc are no
+# longer remounted read-only for the engine process - acceptable because the engine already runs as the unprivileged
+# operator uid with NoNewPrivileges=yes (it cannot write /usr, /boot or /etc anyway) and this manager does not
+# enforce the other filesystem-sandbox directives either (see above). Other units keep ProtectSystem=full.
+# WARNING (probed 2026-11-23): PrivateTmp=yes ALSO yields /dev/shm owner 65534 under this manager - it is NOT merely
+# "not honoured"; adding PrivateTmp (or any mount-namespace directive) to an engine unit would re-break the gate.
+# tests/test_unit_devshm_gate.sh guards the engine template against both.
 _svc_hardening() {
-  printf 'NoNewPrivileges=yes\nProtectSystem=full\n'
+  printf 'NoNewPrivileges=yes\n'
+  [[ "${2:-}" == "no-protectsystem" ]] || printf 'ProtectSystem=full\n'
   if [[ "${1:-basic}" == "strict" ]]; then
     printf 'UMask=0077\nRestrictAddressFamilies=AF_UNIX AF_INET AF_INET6\n'
     printf 'RestrictSUIDSGID=yes\nLockPersonality=yes\nRestrictRealtime=yes\n'
@@ -454,7 +465,7 @@ RestartPreventExitStatus=SIGKILL SIGTERM 98
 MemoryHigh=${memhigh}M
 MemoryMax=${memmax}M
 $(_svc_resource_directives)
-$(_svc_hardening "${level}")
+$(_svc_hardening "${level}" no-protectsystem)
 StandardOutput=append:$(_svc_pct "${LLMCTL_LOG_DIR}")/%i.log
 StandardError=append:$(_svc_pct "${LLMCTL_LOG_DIR}")/%i.log
 
