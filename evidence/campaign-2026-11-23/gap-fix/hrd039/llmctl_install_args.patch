--- /dev/null
+++ b/tests/test_install_args.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+# test_install_args.sh - `llmctl install` must not run the real install for -h/--help/unknown arguments.
+set -euo pipefail
+source "$(dirname "${BASH_SOURCE[0]}")/helpers.sh"
+test_setup_env
+export LLMCTL_FAKE_HW="${LLMCTL_ROOT}/tests/fixtures/hw-baseline.json"
+LLMCTL="${LLMCTL_ROOT}/bin/llmctl"
+for a in --help -h; do
+  o="$("${LLMCTL}" install "$a" 2>&1)" && rc=0 || rc=$?
+  assert_eq 0 "${rc}" "install ${a}: exit 0"
+  assert_contains "${o}" "usage: llmctl install" "install ${a}: prints usage"
+  assert_eq "" "$(ls -A "${LLMCTL_UNIT_DIR}" 2>/dev/null)" "install ${a}: no unit file written (no side effects)"
+done
+o="$("${LLMCTL}" install --bogus 2>&1)" && rc=0 || rc=$?
+assert_eq 2 "${rc}" "install --bogus: exit 2"
+assert_contains "${o}" "nothing was installed" "install --bogus: says nothing was installed"
+assert_eq "" "$(ls -A "${LLMCTL_UNIT_DIR}" 2>/dev/null)" "install --bogus: no unit file written"
+test_finish
