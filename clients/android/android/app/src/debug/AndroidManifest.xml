<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: permit cleartext HTTP to the local dev server (see network_security_config.xml).
     Release builds carry no networkSecurityConfig, so cleartext stays denied (targetSdk >= 28 default). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
