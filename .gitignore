*.pyc
*.db-shm
*.db-wal

# Packaging hygiene (local-only paths; operator decision 2026-11-24).
# .claude/skills/* symlinks into submodules/constitution are per-checkout (speckit-* real dirs stay tracked).
.claude/skills/action-prefix-system
.claude/skills/constitution
.claude/skills/jev-decision-layer
.claude/skills/label-sync
.claude/skills/media-validator
