.claude/skills/reporting-workable-items
.claude/skills/scheduled-work-queue
.claude/skills/session-sync
.claude/skills/skill-catalog
# Backups; .claude/settings.json itself stays local and untracked (deliberately NOT ignored).
*.bak
.claude/settings.json.*.bak*
# Large third-party bundle: referenced by hash in docs/bundles/, never committed.
evidence/campaign-2026-11-23/research/bundles/*.bundle
